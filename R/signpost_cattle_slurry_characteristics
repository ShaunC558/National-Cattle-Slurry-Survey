  mb <- lm(as.formula(paste(info$y, "~ DM_pct")), data = cattle[cattle$Enterprise=="Beef",])
  md <- lm(as.formula(paste(info$y, "~ DM_pct")), data = cattle[cattle$Enterprise=="Dairy",])

  fig <- ggplot(cattle, aes(x = DM_pct, y = .data[[info$y]],
                             colour = Enterprise, shape = Enterprise)) +
    geom_point(size = 2.5, alpha = 0.7) +
    geom_smooth(method = "lm", se = TRUE, aes(fill = Enterprise), alpha = 0.15) +
    scale_colour_manual(values = c("Beef" = "#E8A838", "Dairy" = "#5B9BD5")) +
    scale_fill_manual(values   = c("Beef" = "#E8A838", "Dairy" = "#5B9BD5")) +
    annotate("text", x = min(cattle$DM_pct, na.rm=TRUE) + 0.3,
             y = max(cattle[[info$y]], na.rm=TRUE) * 0.96,
             label = sprintf("Beef: y = %.3f + %.3f \u00d7 DM  (R\u00b2 = %.3f)",
                             coef(mb)[1], coef(mb)[2], summary(mb)$r.squared),
             size = 3.5, hjust = 0, colour = "#E8A838", fontface = "bold") +
    annotate("text", x = min(cattle$DM_pct, na.rm=TRUE) + 0.3,
             y = max(cattle[[info$y]], na.rm=TRUE) * 0.89,
             label = sprintf("Dairy: y = %.3f + %.3f \u00d7 DM  (R\u00b2 = %.3f)",
                             coef(md)[1], coef(md)[2], summary(md)$r.squared),
             size = 3.5, hjust = 0, colour = "#5B9BD5", fontface = "bold") +
    labs(title = paste("Dry Matter vs", info$lab, "by Enterprise"),
         subtitle = "Teagasc Signpost Programme, Ireland 2023–2024",
         x = "Dry Matter (%)", y = info$lab) +
    theme_slurry
  ggsave(file.path(out_dir, info$fn), fig, width = 10, height = 7, dpi = 300)
  cat(sprintf("  %s saved\n", info$fn))
}

